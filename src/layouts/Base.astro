---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path to the social share image. */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Open Graph type: "website" for the home page, "article" for content pages. */
  ogType?: string;
  /** Extra JSON-LD objects for this page (merged into the @graph). */
  schema?: object[];
}

const {
  title,
  description,
  image = '/og-image.jpeg',
  imageWidth = 1182,
  imageHeight = 439,
  ogType = 'website',
  schema = [],
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;

const business = {
  '@type': 'HealthAndBeautyBusiness',
  '@id': `${site.origin}/#organization`,
  name: 'Massage To Go',
  url: `${site.origin}/`,
  logo: imageUrl,
  image: imageUrl,
  telephone: '+31627963822',
  email: 'nathalie@massage-to-go.nl',
  priceRange: '€35 - €140',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rijksweg Noord 5',
    postalCode: '6131 CH',
    addressLocality: 'Sittard',
    addressCountry: 'NL',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '21:00',
    },
  ],
  founder: { '@type': 'Person', name: 'Nathalie Hendrix' },
  sameAs: [
    'https://www.linkedin.com/in/nathaliehendrix',
    'https://www.facebook.com/profile.php?id=100092516869985',
    'https://www.instagram.com/massagetogosittard/',
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    business,
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      url: `${site.origin}/`,
      name: 'Massage To Go',
      inLanguage: 'nl-NL',
      publisher: { '@id': `${site.origin}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'nl-NL',
      isPartOf: { '@id': `${site.origin}/#website` },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/roboto-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-semi-condensed-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon-32.jpeg" sizes="32x32" />
    <link rel="icon" href="/favicon-192.jpeg" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.jpeg" />
    <meta name="msapplication-TileImage" content="/mstile-270.jpeg" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="Massage To Go" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Naar de inhoud</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
