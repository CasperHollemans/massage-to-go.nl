---
/**
 * Click-to-load Google Map. Nothing is requested from Google until the visitor clicks,
 * so the page sets no third-party cookies by default.
 */
interface Props {
  query: string;
  label: string;
}

const { query, label } = Astro.props;
const embedUrl = `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
---

<div class="map-embed" data-map-embed data-src={embedUrl} data-title={`Kaart: ${label}`}>
  <div class="map-embed__placeholder">
    <svg width="40" height="40" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
    </svg>
    <p class="map-embed__address">{label}</p>
    <button class="button map-embed__button" type="button">Toon kaart</button>
    <p class="map-embed__note">
      De kaart wordt geladen via Google Maps. <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
    </p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map-embed]').forEach((container) => {
    container.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = container.dataset.src!;
      iframe.title = container.dataset.title!;
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      container.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .map-embed {
    height: 400px;
    background: var(--color-border);
  }

  .map-embed__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 100%;
    padding: var(--gutter);
    text-align: center;
    color: var(--color-muted);
  }

  .map-embed__placeholder p {
    margin: 0;
  }

  .map-embed__address {
    color: var(--color-text);
  }

  .map-embed__note {
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .map-embed :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
