---
import { getImage } from 'astro:assets';
import poster from '../assets/images/fotos/3-massage-2.jpg';

const posterImage = await getImage({ src: poster, width: 1332, format: 'webp' });
---

<figure class="promo-video container">
  <video
    class="alignwide"
    controls
    playsinline
    preload="none"
    width="1920"
    height="1080"
    poster={posterImage.src}
    aria-label="Video: een massage bij Massage To Go"
  >
    <source src="/video/m2g.mp4" type="video/mp4" />
  </video>
</figure>

<style>
  .promo-video {
    margin-block: 0 1em;
  }

  .promo-video video {
    height: auto;
    max-width: none;
    aspect-ratio: 16 / 9;
    background: #000;
  }
</style>
