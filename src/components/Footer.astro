---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p>Copyright &copy; {year} Massage To Go</p>
</footer>

<style>
  .site-footer {
    min-height: 121px;
    padding: 20px var(--gutter);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .site-footer p {
    margin: 0;
    font-size: var(--fs-footer);
    color: var(--color-muted);
  }
</style>
